{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "payray",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "scripts/dev_server.py"
      ],
      "port": 8765
    },
    {
      "name": "payray-static",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "web-static"
      ],
      "port": 8766
    }
  ]
}