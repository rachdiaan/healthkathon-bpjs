# Salin ke .env dan isi nilainya. Jangan commit .env.
# Koneksi Postgres (login role payray_app di production). Tambahkan password setelah `payray_app` (payray_app:PASSWORD@host).
DATABASE_URL=postgresql://payray_app@127.0.0.1:54329/payray_dev
# Kunci HMAC pseudonim NIK, minimal 32 byte (mis. python -c "import secrets;print(secrets.token_hex(32))")
PAYRAY_NIK_KEY=
# Tampilan estimasi Rp: range | band
PAYRAY_RP_MODE=range
# Mode frontend: live | static
MODE=live
# Password akun demo untuk scripts/seed_users.py (min 12 karakter)
PAYRAY_DEMO_PASSWORD=
